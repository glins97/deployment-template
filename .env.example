# AWS Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here

# Django Backend Configuration
SECRET_KEY=your-super-secret-django-key-change-this-in-production
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,backend,*.your-domain.com

# Database Configuration
POSTGRES_DB=app_production
POSTGRES_USER=app_user
POSTGRES_PASSWORD=secure_password_change_this

# Django Database Settings
DB_ENGINE=django.db.backends.postgresql
DB_HOST=postgres
DB_PORT=5432

# CORS Configuration
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://your-domain.com,https://dev.your-domain.com,https://hml.your-domain.com

# Application URLs (will be set automatically by GitHub Actions)
BACKEND_URL=https://your-domain.com/api
FRONTEND_URL=https://your-domain.com
